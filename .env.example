# Copy to `.env` in the project root (never commit `.env`).

# GitHub username for live project cards + profile stats
VITE_GITHUB_USERNAME=Sishir101

# Formspree: create a form at https://formspree.io → use the id from https://formspree.io/f/YOUR_ID
VITE_FORMSPREE_FORM_ID=

# Deployment base path:
# - Vercel / custom domain: leave empty or VITE_BASE_PATH=/
# - GitHub Pages project site (username.github.io/repo-name): VITE_BASE_PATH=/sishir-portfolio/
VITE_BASE_PATH=/
